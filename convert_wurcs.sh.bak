#!/bin/bash
INPUT_FILE="input.txt"
OUTPUT_FILE="wurcs-smi.txt"
JAR_PATH="./molwurcs.jar"

if [ ! -f "$INPUT_FILE" ]; then
    echo "ERROR: input.txt not found" >&2
    exit 1
fi

> "$OUTPUT_FILE"
echo "Starting conversion..."

while read -r line || [ -n "$line" ]; do
    # スペース等のトリミング
    wurcs=$(echo "$line" | xargs)
    
    # 空行やコメントのスキップ
    if [ -z "$wurcs" ] || echo "$wurcs" | grep -q '^#'; then
        continue
    fi

    # MolWURCSの実行
    smi=$(java -jar "$JAR_PATH" -i WURCS -o SMILES "$wurcs" 2>/dev/null)

    if [ -n "$smi" ]; then
        # 実際の「タブ」と「改行」をそのまま配置
        echo "$wurcs$smi" >> "$OUTPUT_FILE"
    else
        echo "Warning: Failed to convert $wurcs" >&2
    fi
done < "$INPUT_FILE"

echo "Finished! Output: $OUTPUT_FILE"
